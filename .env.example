# Token de votre bot Discord (obtenu sur https://discord.com/developers/applications)
DISCORD_TOKEN=VOTRE_TOKEN_ICI

# ID de l'application (Client ID)
CLIENT_ID=VOTRE_CLIENT_ID_ICI

# ID du propriétaire (Owner ID) pour les commandes réservées au créateur
OWNER_ID=VOTRE_ID_DISCORD_ICI

# Préfixe pour les commandes privées Owner
PREFIX=!

# (Optionnel) ID du serveur pour un déploiement instantané des commandes slash
GUILD_ID=

# Devise par défaut (USD ou EUR)
DEFAULT_CURRENCY=USD

# Intervalle de mise à jour du statut Discord en secondes
STATUS_UPDATE_INTERVAL=60
